; Copy this file to secrets.ini (gitignored) and fill in real values.
; Placeholder values below are enough to compile; WiFi/zenoh only need to
; be correct when actually running on hardware.

[secrets]
build_flags =
    -DWIFI_SSID='"your-ssid"'
    -DWIFI_PASSWORD='"your-password"'
    -DZENOH_CONNECT='"tcp/192.168.0.10:7447"'
